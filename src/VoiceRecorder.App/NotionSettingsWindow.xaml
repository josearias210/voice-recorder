<Window x:Class="VoiceRecorder.App.NotionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Destino · Notion"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}">
    <Border Margin="16" Style="{StaticResource Card}" Padding="22,20">
        <StackPanel>
            <TextBlock Text="Subir sesiones a Notion" Style="{StaticResource DialogTitle}" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,8" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                       Text="Cada sesión se crea como una página de tu base de datos de Notion, con lo que elijas abajo. Nunca se sube nada sin que lo confirmes, y el audio no se sube." />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource MutedBrush}" FontSize="11">
                <Run Text="1. Crea una integración interna en" />
                <Hyperlink Click="OpenIntegrations_Click">notion.so/profile/integrations</Hyperlink>
                <Run Text="y copia su token." />
                <LineBreak />
                <Run Text="2. En la base de datos: … › Conexiones › añade tu integración." />
                <LineBreak />
                <Run Text="3. Pega aquí el enlace de la base de datos. Se rellenan el título y, si existen, «Fecha» (fecha), «Etiquetas» (selección múltiple) y «Duración» (número en minutos o texto)." />
            </TextBlock>

            <CheckBox x:Name="EnabledBox" Content="Usar Notion como destino" Margin="0,0,0,12"
                      Foreground="{DynamicResource TextBrush}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Token de la integración:" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,8" />
                <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="TokenBox" Margin="0,0,0,8" VerticalContentAlignment="Center"
                             ToolTip="Token secreto de la integración interna (ntn_… o secret_…). Se guarda cifrado para tu usuario de Windows." />

                <TextBlock Grid.Row="1" Text="Base de datos (enlace o Id):" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="DatabaseBox" VerticalContentAlignment="Center"
                         ToolTip="Enlace de la base de datos (Compartir › Copiar enlace) o su Id de 32 caracteres" />
            </Grid>
            <TextBlock x:Name="TokenHint" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />

            <TextBlock Text="Qué se sube" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,14,0,6" />
            <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="El título, la fecha, las etiquetas, la duración y las notas se suben siempre. Marca al menos una opción." />
            <WrapPanel>
                <CheckBox x:Name="IncludeSummaryBox" Content="Resumen" Margin="0,0,18,4" Foreground="{DynamicResource TextBrush}"
                          ToolTip="El resumen generado con OpenAI, al principio de la página" />
                <CheckBox x:Name="IncludeTranscriptBox" Content="Transcripción completa" Margin="0,0,18,4" Foreground="{DynamicResource TextBrush}"
                          ToolTip="Todas las intervenciones (Yo/Ellos) con su hora, en un encabezado plegable" />
                <CheckBox x:Name="IncludeReviewBox" Content="Análisis de comunicación (experimental)" Margin="0,0,0,4"
                          Foreground="{DynamicResource TextBrush}"
                          ToolTip="Tu evaluación de la conversación, en un encabezado plegable. Requiere activar el análisis en Configuración › Experimental." />
            </WrapPanel>

            <CheckBox x:Name="AskBox" Margin="0,12,0,0" Foreground="{DynamicResource TextBrush}"
                      Content="Preguntar si subir la sesión a Notion al terminar cada transcripción" />

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12"
                       Foreground="{DynamicResource AccentTextBrush}" />

            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" x:Name="TestButton" Content="Probar conexión" Tag="&#xE73E;" Click="Test_Click"
                        Style="{StaticResource SecondaryButton}"
                        ToolTip="Comprueba el token y la base de datos sin crear nada" />
                <Button DockPanel.Dock="Left" Content="Borrar token" Tag="&#xE74D;" Click="Clear_Click"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Cancelar" IsCancel="True" Click="Cancel_Click"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="Guardar" Tag="&#xE74E;" IsDefault="True" Click="Save_Click" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
