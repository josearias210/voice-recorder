<Window x:Class="VoiceRecorder.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración"
        Width="680" Height="640" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,12,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">

                <!-- Grabación -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Grabación y transcripción local" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="Hay una sesión en curso: el micrófono, el modelo y el idioma se pueden cambiar cuando termine.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanStart}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Micrófono" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                                      ItemsSource="{Binding MicrophoneOptions}" SelectedItem="{Binding SelectedMicrophone}"
                                      IsEnabled="{Binding CanStart}" DisplayMemberPath="Name" VerticalContentAlignment="Center" />

                            <TextBlock Grid.Row="1" Text="Modelo de Whisper" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,8"
                                      ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding CanStart}" VerticalContentAlignment="Center"
                                      SelectionChanged="Model_SelectionChanged" />
                            <Button Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" MinWidth="110"
                                    Content="{Binding DownloadButtonText}" Command="{Binding DownloadModelCommand}" Tag="&#xE896;"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Descarga el modelo seleccionado a tu PC (una sola vez; después funciona sin internet)" />

                            <TextBlock Grid.Row="2" Text="Idioma" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                                      ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguageCode}"
                                      IsEnabled="{Binding CanStart}" DisplayMemberPath="Name" VerticalContentAlignment="Center" />
                        </Grid>
                        <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding DownloadPercent, Mode=OneWay}" Margin="0,2,0,6"
                                     Visibility="{Binding DownloadVisible, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" Margin="0"
                                   Visibility="{Binding DownloadVisible, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Motores, costes y backup -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Motores, costes y backup" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <WrapPanel>
                            <Button Content="Transcripción…" Tag="&#xE8BD;" Click="TranscriptionSettings_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    ToolTip="Motor de transcripción por defecto (Whisper local u OpenAI) y clave de la API de OpenAI" />
                            <Button Content="Costes…" Tag="&#xE8C7;" Click="Costs_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    ToolTip="Cuánto has gastado en transcripciones por mes, y el tiempo y coste de cada una" />
                            <Button Content="Backup externo…" Tag="&#xE753;" Click="Backup_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    ToolTip="Copia de las sesiones en Azure Blob Storage (con la misma estructura que en local)" />
                            <Button Content="Sincronizar…" Tag="&#xE895;" Click="SyncBackup_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    ToolTip="Compara lo que hay en local con el backup externo (falta subir, falta bajar, distinto, sincronizado) y sube o baja a mano" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Apariencia -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Apariencia" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tema" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" />
                            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedValue="{Binding SelectedTheme}" SelectedValuePath="Theme"
                                      DisplayMemberPath="Name" MinWidth="160" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Acerca de -->
                <Border Style="{StaticResource SectionCard}" Margin="0">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Acerca de" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding VersionText, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"
                                   ToolTip="Versión de Voice Recorder" />
                        <WrapPanel>
                            <Button Content="Buscar actualizaciones" Tag="&#xE72C;" Command="{Binding CheckForUpdatesCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    ToolTip="Comprueba ahora si hay una versión nueva en GitHub Releases" />
                            <Button Content="Aviso legal" Tag="&#xE8A5;" Click="LegalNotice_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    ToolTip="Exención de responsabilidad y condiciones de uso (DISCLAIMER.md)" />
                            <Button Content="Privacidad" Tag="&#xE72E;" Click="Privacy_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    ToolTip="Qué datos se guardan y cuándo se usa la red (PRIVACY.md)" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Cerrar" IsCancel="True" IsDefault="True" Click="Close_Click"
                    Style="{StaticResource SecondaryButton}" MinWidth="96" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                       Text="Los cambios se aplican al momento." />
        </DockPanel>
    </Grid>
</Window>
