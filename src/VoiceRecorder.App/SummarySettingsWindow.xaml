<Window x:Class="VoiceRecorder.App.SummarySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resumen · OpenAI"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}">
    <Border Margin="16" Style="{StaticResource Card}" Padding="22,20">
        <StackPanel>
            <TextBlock Text="Resumen de la transcripción" Style="{StaticResource DialogTitle}" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,12" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                       Text="Genera con OpenAI un resumen con puntos clave, decisiones, tareas y preguntas abiertas. Se envía solo el texto de la transcripción (y las notas de la sesión), nunca el audio, con la clave de OpenAI de «Transcripción…». Por defecto se pide a mano con «Generar resumen» en cada sesión." />

            <CheckBox x:Name="AutoBox" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}">
                <TextBlock TextWrapping="Wrap"
                           Text="Generar el resumen automáticamente al terminar cada transcripción (de pago: se envía el texto a OpenAI sin preguntar)." />
            </CheckBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Modelo:" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,8" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ModelBox" VerticalContentAlignment="Center" Margin="0,0,0,8"
                         ToolTip="Modelo de chat de OpenAI que redacta el resumen" />

                <TextBlock Grid.Row="1" Text="Precio entrada (USD / 1 M tokens):" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,8" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="InputPriceBox" VerticalContentAlignment="Center" Margin="0,0,0,8"
                         ToolTip="Solo para estimar costes en «Costes…». Ajústalo si cambias de modelo o de tarifa." />

                <TextBlock Grid.Row="2" Text="Precio salida (USD / 1 M tokens):" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="OutputPriceBox" VerticalContentAlignment="Center"
                         ToolTip="Solo para estimar costes en «Costes…». Ajústalo si cambias de modelo o de tarifa." />
            </Grid>
            <TextBlock x:Name="KeyHint" FontSize="11" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12"
                       Foreground="{DynamicResource AccentTextBrush}" />

            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Cancelar" IsCancel="True" Click="Cancel_Click"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Guardar" Tag="&#xE74E;" IsDefault="True" Click="Save_Click" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
