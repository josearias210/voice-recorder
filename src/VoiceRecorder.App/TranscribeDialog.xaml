<Window x:Class="VoiceRecorder.App.TranscribeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcribir"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Border Margin="14" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel>
            <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,6,0,14" Foreground="{DynamicResource TextBrush}" />

            <TextBlock Text="Transcribir con:" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
            <RadioButton x:Name="WhisperOption" GroupName="Engine" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Whisper local" FontWeight="SemiBold" /><Run x:Name="WhisperDetail" />
                </TextBlock>
            </RadioButton>
            <RadioButton x:Name="OpenAiOption" GroupName="Engine" Foreground="{DynamicResource TextBrush}">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="OpenAI" FontWeight="SemiBold" /><Run x:Name="OpenAiDetail" />
                </TextBlock>
            </RadioButton>
            <TextBlock x:Name="OpenAiHint" FontSize="11" Margin="22,4,0,0" Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" />

            <DockPanel Margin="0,18,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" x:Name="DeclineButton" IsCancel="True" Click="Decline_Click"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Transcribir" IsDefault="True" Click="Transcribe_Click" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
