<Window x:Class="VoiceRecorder.App.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="680" Width="800" MinHeight="440" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera: título editable + chips de metadatos + etiquetas -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Right" Content="Guardar cambios" Tag="&#xE74E;" Click="Save_Click" Margin="12,0,0,0"
                            Padding="12,6" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SaveStatusText}" VerticalAlignment="Center"
                               Margin="8,0,0,0" Foreground="{DynamicResource AccentTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaveStatusText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding SessionTitle, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="17" FontWeight="SemiBold"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                             VerticalContentAlignment="Center"
                             ToolTip="Título de la sesión (edítalo y guarda)" />
                </DockPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,10,0,0">
                    <Border Style="{StaticResource Chip}">
                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding SessionDateText}" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="6,0,0,0">
                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding SegmentChip}" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="6,0,0,0">
                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding WordChip}" />
                    </Border>
                    <TextBlock Text="Etiquetas:" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                               Margin="16,0,6,0" />
                    <TextBox Text="{Binding SessionTags, UpdateSourceTrigger=PropertyChanged}" Width="220"
                             VerticalContentAlignment="Center"
                             ToolTip="Etiquetas separadas por coma (p. ej. trabajo, reunión)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Resumen y análisis (IA) -->
        <StackPanel Grid.Row="1">
        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="0,0,0,10"
                Visibility="{Binding HasCallSummary, Converter={StaticResource BoolToVis}}">
            <Expander IsExpanded="True" Foreground="{DynamicResource TextBrush}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Resumen" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CallSummaryInfo}" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>
                <TextBox Text="{Binding CallSummaryText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,6,0,2"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                         ToolTip="Resumen generado con OpenAI a partir de la transcripción. Puede contener errores: revísalo." />
            </Expander>
        </Border>
        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="0,0,0,10"
                Visibility="{Binding ShowReview, Converter={StaticResource BoolToVis}}">
            <Expander IsExpanded="False" Foreground="{DynamicResource TextBrush}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Análisis de comunicación" FontWeight="SemiBold" />
                        <TextBlock Text="experimental" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontStyle="Italic"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ReviewInfo}" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>
                <TextBox Text="{Binding ReviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,6,0,2"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                         ToolTip="Evaluación generada con OpenAI de cómo condujiste la conversación. Es orientativa: revísala con criterio." />
            </Expander>
        </Border>
        </StackPanel>

        <!-- Chat -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="6">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Segments}" ItemTemplate="{StaticResource ChatBubbleTemplate}"
                              Margin="4,2,4,6" />
            </ScrollViewer>
        </Border>

        <!-- Notas -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Notas de la sesión" FontWeight="SemiBold" FontSize="11"
                           Foreground="{DynamicResource MutedBrush}" Margin="2,2,0,4" />
                <TextBox Text="{Binding SessionNotes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="140"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Background="Transparent" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                         ToolTip="Notas libres sobre la sesión (p. ej. acuerdos, tareas). Se guardan con «Guardar cambios»." />
            </StackPanel>
        </Border>

        <!-- Resumen y Notion -->
        <DockPanel Grid.Row="4" Margin="4,10,4,0">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                       Visibility="{Binding HasNotionLink, Converter={StaticResource BoolToVis}}">
                <Hyperlink Click="OpenNotion_Click" Foreground="{DynamicResource AccentTextBrush}">
                    <Run Text="{Binding NotionLinkText, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SummaryButton" Content="{Binding SummaryButtonText}" Tag="&#xE8BD;" Style="{StaticResource SecondaryButton}"
                        Click="Summarize_Click"
                        ToolTip="Genera con OpenAI un resumen con puntos clave, decisiones y tareas. Solo se envía el texto de la transcripción (nunca el audio), con tu clave." />
                <Button x:Name="ReviewButton" Content="{Binding ReviewButtonText}" Tag="&#xE9D9;" Style="{StaticResource SecondaryButton}"
                        Margin="6,0,0,0" Click="Review_Click"
                        Visibility="{Binding IsReviewEnabled, Converter={StaticResource BoolToVis}}"
                        ToolTip="Experimental: evalúa con OpenAI cómo condujiste la conversación (escucha, empatía, manejo del desacuerdo, persuasión) y propone mejoras. Solo se envía el texto." />
                <Button x:Name="NotionButton" Content="Subir a Notion" Tag="&#xE898;" Style="{StaticResource SecondaryButton}"
                        Margin="6,0,0,0" Click="UploadNotion_Click"
                        ToolTip="Crea una página en tu base de datos de Notion con el resumen y la transcripción. Se configura en Configuración › «Notion…»." />
                <TextBlock Text="{Binding ActionStatus}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" />
            </StackPanel>
        </DockPanel>

        <!-- Acciones -->
        <DockPanel Grid.Row="5" Margin="4,10,4,0">
            <Button DockPanel.Dock="Right" Content="Cerrar" Style="{StaticResource SecondaryButton}" Click="Close_Click" />
            <Button DockPanel.Dock="Right" Content="Eliminar sesión" Tag="&#xE74D;" Style="{StaticResource DangerButton}"
                    Click="Delete_Click" Margin="0,0,8,0" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Exportar:" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,8,0" />
                <Button Content="TXT" Style="{StaticResource SecondaryButton}" Click="ExportTxt_Click" />
                <Button Content="Markdown" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="ExportMd_Click" />
                <Button Content="SRT" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="ExportSrt_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
