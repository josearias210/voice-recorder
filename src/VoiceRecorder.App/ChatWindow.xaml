<Window x:Class="VoiceRecorder.App.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="680" Width="800" MinHeight="440" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera: título editable + chips de metadatos + etiquetas -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Right" Content="Guardar cambios" Click="Save_Click" Margin="12,0,0,0"
                            Padding="12,6" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SaveStatusText}" VerticalAlignment="Center"
                               Margin="8,0,0,0" Foreground="{DynamicResource AccentBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaveStatusText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding SessionTitle, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="17" FontWeight="SemiBold"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                             VerticalContentAlignment="Center"
                             ToolTip="Título de la sesión (edítalo y guarda)" />
                </DockPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,10,0,0">
                    <Border Style="{StaticResource Chip}">
                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding SessionDateText}" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="6,0,0,0">
                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding SegmentChip}" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="6,0,0,0">
                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding WordChip}" />
                    </Border>
                    <TextBlock Text="Etiquetas:" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                               Margin="16,0,6,0" />
                    <TextBox Text="{Binding SessionTags, UpdateSourceTrigger=PropertyChanged}" Width="220"
                             VerticalContentAlignment="Center"
                             ToolTip="Etiquetas separadas por coma (p. ej. trabajo, reunión)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="6">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Segments}" ItemTemplate="{StaticResource ChatBubbleTemplate}"
                              Margin="4,2,4,6" />
            </ScrollViewer>
        </Border>

        <!-- Notas -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Notas de la sesión" FontWeight="SemiBold" FontSize="11"
                           Foreground="{DynamicResource MutedBrush}" Margin="2,2,0,4" />
                <TextBox Text="{Binding SessionNotes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="140"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Background="Transparent" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                         ToolTip="Notas libres sobre la sesión (p. ej. acuerdos, tareas). Se guardan con «Guardar cambios»." />
            </StackPanel>
        </Border>

        <!-- Acciones -->
        <DockPanel Grid.Row="3" Margin="4,10,4,0">
            <Button DockPanel.Dock="Right" Content="Cerrar" Style="{StaticResource SecondaryButton}" Click="Close_Click" />
            <Button DockPanel.Dock="Right" Content="Eliminar sesión" Style="{StaticResource DangerButton}"
                    Click="Delete_Click" Margin="0,0,8,0" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Exportar:" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,8,0" />
                <Button Content="TXT" Style="{StaticResource SecondaryButton}" Click="ExportTxt_Click" />
                <Button Content="Markdown" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="ExportMd_Click" />
                <Button Content="SRT" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="ExportSrt_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
