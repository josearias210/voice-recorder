<Window x:Class="VoiceRecorder.App.BackupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup externo · Azure Blob Storage"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Border Margin="14" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel>
            <TextBlock Text="Backup externo" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,12" Foreground="{DynamicResource MutedBrush}" FontSize="12">
                <Run Text="Las sesiones se guardan siempre en local, en" />
                <Run x:Name="LocalFolderRun" FontFamily="Consolas" />
                <Run Text=". El backup es siempre manual: desde «☁ Sincronizar…» ves las diferencias con la nube y decides qué subir o bajar, con la misma estructura de carpetas. Nunca se borra nada en la nube." />
            </TextBlock>

            <CheckBox x:Name="EnabledBox" Content="Usar backup en Azure Blob Storage" Margin="0,0,0,12"
                      Foreground="{DynamicResource TextBrush}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Cuenta de almacenamiento:" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,8" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="AccountBox" Margin="0,0,0,8" VerticalContentAlignment="Center"
                         ToolTip="Nombre de la cuenta de Azure Storage (p. ej. micuenta)" />

                <TextBlock Grid.Row="1" Text="Contenedor:" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,8" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ContainerBox" Margin="0,0,0,8" VerticalContentAlignment="Center"
                         ToolTip="Contenedor de blobs; se crea si no existe (minúsculas, números y guiones)" />

                <TextBlock Grid.Row="2" Text="Clave de acceso (key):" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0" />
                <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="KeyBox" VerticalContentAlignment="Center"
                             ToolTip="Access key de la cuenta (o una cadena de conexión). Se guarda cifrada para tu usuario de Windows." />
            </Grid>
            <TextBlock x:Name="KeyHint" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12"
                       Foreground="{DynamicResource AccentBrush}" />

            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" x:Name="TestButton" Content="Probar conexión" Click="Test_Click"
                        Style="{StaticResource SecondaryButton}" />
                <Button DockPanel.Dock="Right" Content="Cancelar" IsCancel="True" Click="Cancel_Click"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="Guardar" IsDefault="True" Click="Save_Click" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
