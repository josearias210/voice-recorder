<Window x:Class="VoiceRecorder.App.CostsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Costes de transcripción"
        Width="900" Height="600" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Resumen del mes en curso y total -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Gastado este mes" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="MonthCostText" FontSize="24" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Transcripciones este mes" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="MonthRunsText" FontSize="24" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Tiempo transcribiendo este mes" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="MonthTimeText" FontSize="24" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Total desde el principio" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="TotalCostText" FontSize="24" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Meses -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Por mes" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,8" />
                    <TextBlock DockPanel.Dock="Top" x:Name="EmptyText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,0"
                               Text="Aún no hay transcripciones registradas. Cada transcripción guarda aquí su motor, tiempo y coste." />
                    <ListBox x:Name="MonthsList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             SelectionChanged="MonthsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding Cost}" FontSize="13" Foreground="{DynamicResource AccentTextBrush}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Transcripciones del mes seleccionado -->
            <Border Grid.Column="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="10" Margin="10,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="DetailHeader" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,8" />
                    <Grid DockPanel.Dock="Top" Margin="4,0,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fecha" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Grid.Column="1" Text="Sesión" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Grid.Column="2" Text="Motor · modelo" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Grid.Column="3" Text="Audio" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Tiempo" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Coste" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="RunsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Date}" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Session}" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Session}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Engine}" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Engine}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Audio}" FontSize="12" Foreground="{DynamicResource TextBrush}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{Binding Time}" FontSize="12" Foreground="{DynamicResource TextBrush}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="{Binding Cost}" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" TextAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="2,10,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Cerrar" IsCancel="True" Click="Close_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Ver uso real en OpenAI" Tag="&#xE8A7;" Click="OpenAiUsage_Click" Style="{StaticResource SecondaryButton}"
                    ToolTip="Abre en el navegador el panel de uso de tu cuenta de OpenAI (importe facturado real)" />
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"
                       Text="Whisper local es gratis: solo cuenta el tiempo. El coste de OpenAI es una estimación (audio enviado × precio configurado en «Transcripción…»); el importe real es el de tu panel de OpenAI. Los registros se conservan aunque borres la sesión." />
        </DockPanel>
    </Grid>
</Window>
