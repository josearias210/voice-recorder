<Window x:Class="VoiceRecorder.App.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sincronizar con el backup externo"
        Height="680" Width="900" MinHeight="460" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <!-- Color de cada estado: verde sincronizado, ámbar falta subir, azul falta bajar, rojo distinto -->
        <Style x:Key="StateChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Synced">
                    <Setter Property="Background" Value="#3322C55E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="LocalOnly">
                    <Setter Property="Background" Value="#33F59E0B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="RemoteOnly">
                    <Setter Property="Background" Value="#333B82F6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Different">
                    <Setter Property="Background" Value="#33EF4444" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,3" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="↻ Comparar de nuevo" Click="Refresh_Click"
                    Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="Sincronizar con el backup externo" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="TargetText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Porcentaje sincronizado -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="PercentText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                           Text="Comparando…" />
                <ProgressBar x:Name="PercentBar" Height="8" Minimum="0" Maximum="100" Margin="0,8,0,0" Foreground="#22C55E" />
            </StackPanel>
        </Border>

        <!-- Resumen de diferencias -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,-8,10">
            <Border Style="{StaticResource SummaryCard}" BorderBrush="#22C55E">
                <StackPanel>
                    <TextBlock x:Name="SyncedValue" Style="{StaticResource CardValue}" Text="–" />
                    <TextBlock Style="{StaticResource CardLabel}" Text="✓ Sincronizados (iguales en local y en la nube)" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}" BorderBrush="#F59E0B">
                <StackPanel>
                    <TextBlock x:Name="LocalOnlyValue" Style="{StaticResource CardValue}" Text="–" />
                    <TextBlock Style="{StaticResource CardLabel}" Text="⬆ En local, no están arriba (falta subir)" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}" BorderBrush="#3B82F6">
                <StackPanel>
                    <TextBlock x:Name="RemoteOnlyValue" Style="{StaticResource CardValue}" Text="–" />
                    <TextBlock Style="{StaticResource CardLabel}" Text="⬇ Arriba, no están en local (falta bajar)" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}" BorderBrush="#EF4444">
                <StackPanel>
                    <TextBlock x:Name="DifferentValue" Style="{StaticResource CardValue}" Text="–" />
                    <TextBlock Style="{StaticResource CardLabel}" Text="≠ En ambos con contenido distinto" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Lista de sesiones -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="6,2,6,8" LastChildFill="False">
                    <CheckBox DockPanel.Dock="Left" x:Name="SelectAllBox" Content="Todas" Click="SelectAll_Click"
                              Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Left" Content="Marcar pendientes de subir" Click="SelectPendingUpload_Click"
                            Style="{StaticResource SecondaryButton}" Padding="10,3" FontSize="12" Margin="14,0,0,0" />
                    <Button DockPanel.Dock="Left" Content="Marcar pendientes de bajar" Click="SelectPendingDownload_Click"
                            Style="{StaticResource SecondaryButton}" Padding="10,3" FontSize="12" Margin="8,0,0,0" />
                    <ComboBox DockPanel.Dock="Right" x:Name="FilterBox" MinWidth="190" SelectionChanged="Filter_SelectionChanged"
                              VerticalContentAlignment="Center" DisplayMemberPath="Name" />
                    <TextBlock DockPanel.Dock="Right" Text="Mostrar:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource MutedBrush}" />
                </DockPanel>
                <ListBox Grid.Row="1" x:Name="SessionsList" BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,8"
                                    ToolTip="{Binding FilesText}" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                              Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DetailText}" FontSize="12" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StateChip}" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Estado -->
        <StackPanel Grid.Row="4" Margin="2,10,2,0">
            <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,0,0,6" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>

        <!-- Acciones -->
        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <CheckBox DockPanel.Dock="Left" x:Name="OverwriteBox" VerticalAlignment="Center"
                      Content="Al bajar, sobrescribir archivos locales distintos"
                      Foreground="{DynamicResource TextBrush}"
                      ToolTip="Sin marcar, al bajar solo se descargan los archivos que faltan en este equipo. Al subir, los archivos distintos siempre reemplazan a los de la nube." />
            <Button DockPanel.Dock="Right" Content="Cerrar" IsCancel="True" Click="Close_Click"
                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" x:Name="DownloadButton" Content="⬇ Bajar marcadas" Click="Download_Click"
                    Margin="8,0,0,0"
                    ToolTip="Descarga a este equipo lo que falta de las sesiones marcadas" />
            <Button DockPanel.Dock="Right" x:Name="UploadButton" Content="⬆ Subir marcadas" Click="Upload_Click"
                    ToolTip="Sube lo que falta arriba y reemplaza lo que cambió (no borra nada en la nube ni sube dos veces lo mismo)" />
        </DockPanel>
    </Grid>
</Window>
