<Window x:Class="VoiceRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, Mode=OneWay, FallbackValue='Voice Recorder · Transcriptor de llamadas'}"
        Height="760" Width="1200" MinHeight="580" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        Icon="Assets/app.ico">
    <Window.Resources>
        <!-- Punto de estado: rojo pulsante al grabar, ámbar en pausa -->
        <Style x:Key="LiveDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Recording">
                    <Setter Property="Fill" Value="{DynamicResource DangerTextBrush}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15"
                                                 Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                 Duration="0:0:0.2" FillBehavior="Stop" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Paused">
                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Pausar/Reanudar: el icono sigue al estado. -->
        <Style x:Key="PauseButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Tag" Value="&#xE769;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Paused">
                    <Setter Property="Tag" Value="&#xE768;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Insignia circular de la marca; roja al grabar. -->
        <Style x:Key="BrandBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Recording">
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Paused">
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmptyTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>

        <Style x:Key="EmptyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="380" />
        </Style>

        <Style x:Key="EmptyIcon" TargetType="Border">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="64" />
            <Setter Property="CornerRadius" Value="32" />
            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Banner de actualización -->
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" CornerRadius="12" Padding="16,10"
                Margin="0,0,0,12" Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Actualizar y reiniciar" Padding="12,6" Tag="&#xE777;"
                        Background="White" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                        Command="{Binding UpdateNowCommand}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Foreground="White" FontSize="16" Margin="0,0,10,0" />
                    <TextBlock Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13">
                        <Run Text="Nueva versión " /><Run Text="{Binding UpdateVersion, Mode=OneWay}" /><Run Text=" disponible" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Cabecera: marca, estado con cronómetro y controles de la sesión -->
        <Border Grid.Row="1" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Recording">
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Paused">
                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource BrandBadge}" Width="44" Height="44" CornerRadius="22"
                        VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="20" Foreground="White"
                               HorizontalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource LiveDot}" Width="8" Height="8" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Recording">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Paused">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding ElapsedText}" FontSize="26" FontWeight="SemiBold"
                               FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextBrush}"
                               Margin="0,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Iniciar" Tag="&#xE768;" Command="{Binding StartCommand}" MinWidth="104"
                            FontWeight="SemiBold" Padding="16,9" />
                    <Button Content="{Binding PauseButtonText}" Command="{Binding PauseResumeCommand}" MinWidth="104"
                            Margin="8,0,0,0" Padding="16,9" Style="{StaticResource PauseButton}" />
                    <Button Content="Detener" Tag="&#xE71A;" Command="{Binding StopCommand}" MinWidth="104"
                            Margin="8,0,0,0" Padding="16,9" Style="{StaticResource DangerButton}" />
                    <Border Width="1" Height="30" Margin="16,0" Background="{DynamicResource BorderBrush}" />
                    <Button Content="Transcribir archivo…" Tag="&#xE8E5;" Command="{Binding TranscribeFileCommand}"
                            Padding="14,9" Style="{StaticResource SecondaryButton}"
                            ToolTip="Transcribe un archivo de audio o vídeo. También puedes arrastrarlo a la ventana." />
                    <Button x:Name="HistoryButton" Content="Historial" Tag="&#xE81C;" Click="HistoryToggle_Click"
                            Margin="8,0,0,0" Padding="14,9" Style="{StaticResource SecondaryButton}"
                            ToolTip="Muestra u oculta el historial de sesiones (Ctrl+H)" />
                    <Button Click="Settings_Click" Margin="8,0,0,0" Padding="11,9" Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="Configuración"
                            ToolTip="Configuración: micrófono, modelo, idioma, motores, costes, backup, tema y acerca de">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="16"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Zona principal: transcripción + historial -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Transcripción -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="12,10,12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="Transcripción" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" Padding="10,3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="#26EF4444" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Recording">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Paused">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Background" Value="#26F59E0B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource LiveDot}" Width="7" Height="7" Margin="0,0,6,0" />
                                <TextBlock FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="GRABANDO AUDIO" />
                                            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Paused">
                                                    <Setter Property="Text" Value="EN PAUSA" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Segments}" ItemTemplate="{StaticResource ChatBubbleTemplate}"
                                      Margin="4,0,4,8" />
                    </ScrollViewer>

                    <!-- Grabando: aún no hay texto, solo audio -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="24,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Recording">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Paused">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Style="{StaticResource EmptyIcon}" Background="#26EF4444">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="26"
                                       Foreground="{DynamicResource DangerTextBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{StaticResource EmptyTitle}" Text="Grabando la llamada" />
                        <TextBlock Style="{StaticResource EmptyText}"
                                   Text="El audio se guarda por canal (micrófono y llamada). Al pulsar Detener podrás elegir si transcribirlo y con qué motor." />
                    </StackPanel>

                    <!-- Sin sesión abierta: invitación a empezar -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="24,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Segments.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Recording">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Paused">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Style="{StaticResource EmptyIcon}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="26"
                                       Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{StaticResource EmptyTitle}" Text="Listo para grabar" />
                        <TextBlock Style="{StaticResource EmptyText}"
                                   Text="Pulsa Iniciar para grabar tu llamada, o arrastra aquí un archivo de audio o vídeo para transcribirlo." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Historial: panel lateral, oculto hasta que se pulsa «Historial» -->
            <Border x:Name="HistoryPanel" Grid.Column="1" Style="{StaticResource Card}" Padding="14" Margin="12,0,0,0"
                    Width="380" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="2,0,0,10">
                        <Button DockPanel.Dock="Right" Click="HistoryToggle_Click" Style="{StaticResource GhostButton}"
                                Padding="6,4" AutomationProperties.Name="Cerrar historial" ToolTip="Cerrar el historial">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="Historial de sesiones" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Buscar" Tag="&#xE721;" Command="{Binding SearchCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                        <Grid>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="SearchBox_KeyDown" VerticalContentAlignment="Center" Padding="30,6,8,6"
                                     ToolTip="Busca por título, etiquetas o texto de la transcripción" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Margin="11,0,0,0"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" />
                            <!-- Texto de ayuda mientras la búsqueda está vacía. -->
                            <TextBlock Text="Buscar sesiones…" Margin="32,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <ListBox x:Name="HistoryList" Grid.Row="2" ItemsSource="{Binding History}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch" MouseDoubleClick="HistoryList_MouseDoubleClick">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,5,0" />
                                            <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}">
                                                <Run Text="{Binding StartedAtText, Mode=OneWay}" />
                                                ·
                                                <Run Text="{Binding DurationText, Mode=OneWay}" />
                                                ·
                                                <Run Text="{Binding SegmentCountText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <!-- Sin etiquetas: la fila sobra. -->
                                                        <DataTrigger Binding="{Binding TagsText}" Value="—">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8EC;" FontSize="11"
                                                       Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,5,0" />
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AccentTextBrush}"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding TagsText, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding TranscriptionText, Mode=OneWay}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="Última transcripción: motor, tiempo que tardó y coste estimado"
                                                   Visibility="{Binding HasTranscriptionInfo, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ListBox>

                    <!-- Historial vacío -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="12,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="28" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Style="{StaticResource EmptyTitle}" Text="Sin sesiones" FontSize="14" />
                        <TextBlock Style="{StaticResource EmptyText}"
                                   Text="Aquí aparecerán tus grabaciones. Si estabas buscando, prueba con otras palabras." />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="Abrir chat" Tag="&#xE8BD;" Style="{StaticResource SecondaryButton}" Click="OpenSession_Click"
                                    Margin="0,0,8,8" />
                            <Button Content="Transcribir…" Tag="&#xE70F;" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    Click="TranscribeSession_Click" IsEnabled="{Binding CanStart}"
                                    ToolTip="Transcribe (o vuelve a transcribir) el audio guardado de la sesión seleccionada con el motor que elijas" />
                            <Button Content="Carpeta" Tag="&#xE838;" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    Click="OpenSessionFolder_Click"
                                    ToolTip="Abre la carpeta de la sesión seleccionada (transcripción y audio), o la carpeta de sesiones" />
                            <Button Content="Eliminar" Tag="&#xE74D;" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    Click="DeleteSession_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Estado -->
        <DockPanel Grid.Row="3" Margin="4,10,0,0">
            <Button DockPanel.Dock="Right" Content="Cancelar" Tag="&#xE711;" Command="{Binding CancelImportCommand}"
                    Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}" />
            <StackPanel VerticalAlignment="Center">
                <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding DownloadPercent, Mode=OneWay}"
                             Visibility="{Binding DownloadVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,5" />
                <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Recording">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
