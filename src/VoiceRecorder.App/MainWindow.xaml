<Window x:Class="VoiceRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Recorder · Transcriptor de llamadas"
        Height="720" Width="1180" MinHeight="560" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Icon="Assets/app.ico">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de control de sesión -->
        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="▶ Iniciar" Command="{Binding StartCommand}" MinWidth="96" FontWeight="SemiBold" />
                <Button Content="{Binding PauseButtonText}" Command="{Binding PauseResumeCommand}" MinWidth="96"
                        Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" />
                <Button Content="■ Detener" Command="{Binding StopCommand}" MinWidth="96" Margin="8,0,0,0"
                        Style="{StaticResource DangerButton}" />
                <TextBlock Text="{Binding StateText}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                           Margin="22,0,0,0" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding ElapsedText}" FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontFamily="Consolas" />
            </StackPanel>
        </Border>

        <!-- Zona principal: chat vivo + historial -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Transcripción en vivo -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Transcripción en vivo" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                               Margin="12,8,12,4" />
                    <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Segments}" Margin="4,0,4,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BubbleBorder}">
                                        <StackPanel>
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2">
                                                <Run Text="{Binding SpeakerLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding TimeText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                                                       Foreground="{StaticResource TextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Historial -->
            <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Historial de sesiones" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Buscar" Command="{Binding SearchCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchBox_KeyDown" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="HistoryList" Grid.Row="2" ItemsSource="{Binding History}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch" MouseDoubleClick="HistoryList_MouseDoubleClick">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0">
                                            <Run Text="{Binding StartedAtText, Mode=OneWay}" />
                                            ·
                                            <Run Text="{Binding DurationText, Mode=OneWay}" />
                                            ·
                                            <Run Text="{Binding SegmentCountText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="🏷 " /><Run Text="{Binding TagsText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Abrir chat" Style="{StaticResource SecondaryButton}" Click="OpenSession_Click" />
                        <Button Content="Eliminar" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="DeleteSession_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Ajustes -->
        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Modelo:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <ComboBox ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="DisplayName"
                          MinWidth="170" Margin="8,0,4,0" VerticalContentAlignment="Center" SelectionChanged="Model_SelectionChanged" />
                <Button Content="Descargar" Command="{Binding DownloadModelCommand}" Style="{StaticResource SecondaryButton}" />
                <TextBlock Text="Idioma:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="18,0,0,0" />
                <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguage.Code}"
                          DisplayMemberPath="Name" MinWidth="150" Margin="8,0,0,0" VerticalContentAlignment="Center" />
                <TextBlock Text="Micrófono:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="18,0,0,0" />
                <ComboBox ItemsSource="{Binding MicrophoneOptions}" SelectedItem="{Binding SelectedMicrophone}"
                          DisplayMemberPath="Name" MinWidth="230" MaxWidth="280" Margin="8,0,0,0" VerticalContentAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Estado -->
        <StackPanel Grid.Row="3" Margin="4,8,4,0">
            <ProgressBar Height="4" Minimum="0" Maximum="1" IsIndeterminate="{Binding DownloadVisible}"
                         Visibility="{Binding DownloadVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
        </StackPanel>
    </Grid>
</Window>

