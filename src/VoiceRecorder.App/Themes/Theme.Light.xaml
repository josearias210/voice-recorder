<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema claro. Contrastes pensados para WCAG AA sobre PanelBackground. -->
    <!-- Fondos de botón: texto blanco encima. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerDarkBrush" Color="#B91C1C" />

    <!-- Variantes para texto sobre fondos claros. -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />

    <SolidColorBrush x:Key="WindowBackground" Color="#F1F5F9" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="BubbleMe" Color="#DBEAFE" />
    <SolidColorBrush x:Key="BubbleThem" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AvatarThemBrush" Color="#64748B" />
    <SolidColorBrush x:Key="AvatarOtherBrush" Color="#475569" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#64748B" />
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#2563EB" />

</ResourceDictionary>
