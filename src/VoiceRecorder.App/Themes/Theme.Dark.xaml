<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema oscuro (slate) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="WindowBackground" Color="#0F172A" />
    <SolidColorBrush x:Key="PanelBackground" Color="#1E293B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="TextBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="BubbleMe" Color="#1E3A8A" />
    <SolidColorBrush x:Key="BubbleThem" Color="#334155" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="HoverBrush" Color="#334155" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#475569" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#94A3B8" />
