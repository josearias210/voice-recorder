<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 + Microsoft.Testing.Platform: cada proyecto de pruebas es un ejecutable. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VoiceRecorder.Core\VoiceRecorder.Core.csproj" />
    <ProjectReference Include="..\..\src\VoiceRecorder.Audio\VoiceRecorder.Audio.csproj" />
    <ProjectReference Include="..\..\src\VoiceRecorder.Transcription\VoiceRecorder.Transcription.csproj" />
    <ProjectReference Include="..\..\src\VoiceRecorder.Storage\VoiceRecorder.Storage.csproj" />
    <ProjectReference Include="..\..\src\VoiceRecorder.App\VoiceRecorder.App.csproj" />
  </ItemGroup>

</Project>

