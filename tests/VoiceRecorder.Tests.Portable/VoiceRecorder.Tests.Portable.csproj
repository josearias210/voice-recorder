<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Subconjunto multiplataforma de las pruebas (sin WPF, WASAPI ni NAudio).
    Reutiliza los mismos archivos de tests/VoiceRecorder.Tests para que se
    puedan ejecutar en Linux/Docker:  .\scripts\docker.ps1 test
    El conjunto completo (net10.0-windows) se ejecuta en el CI de Windows.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 + Microsoft.Testing.Platform: cada proyecto de pruebas es un ejecutable. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>VoiceRecorder.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\VoiceRecorder.Tests\BackupServiceTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\VoiceRecorder.Tests\ConversationTranscriberTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\VoiceRecorder.Tests\FileSessionStoreTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\VoiceRecorder.Tests\FileTranscriberTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\VoiceRecorder.Tests\ModelManagerTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\VoiceRecorder.Tests\OpenAiTranscriberTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\VoiceRecorder.Tests\SilenceGapTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\VoiceRecorder.Tests\SpeechSegmenterTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\VoiceRecorder.Tests\SQLiteSessionStoreTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\VoiceRecorder.Tests\TranscriptionLogTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\VoiceRecorder.Tests\UtteranceBatcherTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\VoiceRecorder.Tests\WhisperTranscriberTests.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VoiceRecorder.Core\VoiceRecorder.Core.csproj" />
    <ProjectReference Include="..\..\src\VoiceRecorder.Transcription\VoiceRecorder.Transcription.csproj" />
    <ProjectReference Include="..\..\src\VoiceRecorder.Storage\VoiceRecorder.Storage.csproj" />
  </ItemGroup>

</Project>
